# Written by scripts/setup.sh into <site>/.env (chmod 600). Never commit it.
# CLOSEHUB_SANDBOX_BACKEND: php | playground. CLOSEHUB_SANDBOX_TYPE: plugin | theme | none.
CLOSEHUB_SANDBOX_NAME=my-plugin
CLOSEHUB_SANDBOX_BACKEND=php
CLOSEHUB_SANDBOX_TYPE=plugin
CLOSEHUB_SANDBOX_PROJECT=/path/to/my-plugin
CLOSEHUB_SANDBOX_PORT=8080
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=true
CLOSEHUB_SANDBOX_ADMIN_USER=admin
CLOSEHUB_SANDBOX_ADMIN_PASSWORD=password
# Optional:
# CLOSEHUB_SANDBOX_PLAYGROUND_VERSION=latest
# PHP_CLI_SERVER_WORKERS=4
