# Written by scripts/setup.sh into <site>/.env (chmod 600). Never commit it.
# SANDBOXWP_BACKEND: php | playground. SANDBOXWP_TYPE: plugin | theme | none.
SANDBOXWP_NAME=my-plugin
SANDBOXWP_BACKEND=php
SANDBOXWP_TYPE=plugin
SANDBOXWP_PROJECT=/path/to/my-plugin
SANDBOXWP_PORT=8080
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=true
SANDBOXWP_ADMIN_USER=admin
SANDBOXWP_ADMIN_PASSWORD=generated-on-setup
# Optional:
# SANDBOXWP_PLAYGROUND_VERSION=latest
# PHP_CLI_SERVER_WORKERS=4
